// ========================================
// PROJECT ALPHA — Database Schema
// AI Trading Coach | Supabase-Compatible
// Ref: Architecture Bible BAB 17
// ========================================
// Note: PostgreSQL via Supabase for all environments.
// All tables use CUID for IDs.
// ========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Relation mode for serverless (Supabase pooler)
  relationMode = "prisma"
}

// ========================================
// IDENTITY DOMAIN
// ========================================

model Trader {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  timezone  String   @default("Asia/Makassar")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  readinessScores  TraderReadinessScore[]
  tradeEntries      TradeEntry[]
  coachingSessions  CoachingSession[]
  memoryL0Events    MemoryL0Event[]
  memoryL1Summary   MemoryL1Summary?
  memoryL2Digest    MemoryL2Digest?
  processScoreSnaps ProcessScoreSnapshot[]
  weeklyReviews     WeeklyReviewRecord[]
  playbooks         Playbook[]
  behavioralEvents  BehavioralEvent[]
  growthSnapshots   GrowthSnapshot[]
  reflectionGaps    ReflectionGapRecord[]
  tradingDNA        TradingDNA?
  growthReports     GrowthReport[]
}

model TraderReadinessScore {
  id          String   @id @default(cuid())
  traderId    String
  hasStrategy      Boolean @default(false)
  consistentTrading Boolean @default(false)
  willingToReflect  Boolean @default(false)
  willingToLearn    Boolean @default(false)
  willingToRecord   Boolean @default(false)
  totalScore        Int     @default(0)
  createdAt  DateTime @default(now())

  trader Trader @relation(fields: [traderId], references: [id])
}

// ========================================
// TRADING DOMAIN
// ========================================

model TradeEntry {
  id          String   @id @default(cuid())
  traderId    String

  // Trade Data
  pair        String   // e.g., "EURUSD", "GBPJPY"
  direction   String   // "LONG" or "SHORT"
  timeframe   String?  // e.g., "H1", "H4", "D1"
  strategy    String?

  // Price Data
  entryPrice  Float
  exitPrice   Float?
  stopLoss    Float?
  takeProfit  Float?

  // Position
  lotSize     Float?
  pipResult   Float?

  // P/L
  profitLoss  Float    @default(0)
  currency    String   @default("USD")

  // Status
  status      String   @default("OPEN") // OPEN, CLOSED, PARTIAL

  // Timing
  entryTime   DateTime?
  exitTime    DateTime?

  // Screenshot
  screenshotUrl String?

  // Process Score
  processScore Int?     @default(0) // 0-100

  // Reflection
  planNotes       String? // What was the plan before entry
  reflectionNotes String? // Post-trade reflection
  emotionBefore   String? // Felt emotion before trade
  emotionAfter    String? // Felt emotion after trade
  lessonLearned   String?
  hasReflected    Boolean @default(false)

  // Tags
  tags String? // JSON array of tags: ["revenge", "planned", "impulsive"]

  // Playbook Link
  playbookId    String?

  // Behavioral Tags (AI-detected)
  behavioralTags String? // JSON: ["revenge_trading", "fomo", "overconfidence"]
  playbookCompliance Float? // 0.0 - 1.0 how well trade followed playbook checklist

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  trader   Trader   @relation(fields: [traderId], references: [id])
  playbook Playbook? @relation(fields: [playbookId], references: [id])
}

// ========================================
// COACHING DOMAIN
// ========================================

model CoachingSession {
  id            String   @id @default(cuid())
  traderId      String
  sessionType   String   @default("REFLECTION") // REFLECTION, WEEKLY_REVIEW, FREE_CHAT
  status        String   @default("ACTIVE") // ACTIVE, COMPLETED, INTERRUPTED
  title         String?
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  traderRating  Int?     // 1-5 optional rating

  trader Trader @relation(fields: [traderId], references: [id])

  // Structured Reflection Flow
  reflectionStep      String? // Current step in reflection flow
  reflectionProgress   String? // JSON: { "currentStep": 2, "totalSteps": 5, "completedSteps": [1] }
  linkedTradeId       String? // Trade being reflected on (if any)

  // Relations
  conversationTurns ConversationTurn[]
}

model ConversationTurn {
  id              String   @id @default(cuid())
  coachingSessionId String
  role            String   // "USER" or "AI_COACH"
  content         String
  templateUsed    String? // Which prompt template was used

  coachingSession CoachingSession @relation(fields: [coachingSessionId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

// ========================================
// MEMORY DOMAIN (CP-01)
// ========================================

model MemoryL0Event {
  id          String   @id @default(cuid())
  traderId    String
  eventType   String   // "TradeSaved", "CoachSessionCompleted", "PatternDetected"
  eventData   String   // JSON payload
  createdAt   DateTime @default(now())

  trader Trader @relation(fields: [traderId], references: [id])
}

model MemoryL1Summary {
  id          String   @id @default(cuid())
  traderId    String   @unique
  summary     String   // Rolling summary of recent activity
  periodStart DateTime
  periodEnd   DateTime?
  updatedAt   DateTime @updatedAt

  trader Trader @relation(fields: [traderId], references: [id])
}

model MemoryL2Digest {
  id          String   @id @default(cuid())
  traderId    String   @unique
  personaType     String?  // "DIMAS_TYPE", "RANI_TYPE", "SPECTRUM"
  dominantPatterns String? // JSON array of dominant patterns
  readinessTrend  String? // "IMPROVING", "STABLE", "DECLINING"
  psychologicalNotes String? // AI-generated psychological notes
  // Enhanced L2 memory fields
  tradingStyle       String? // "SCALPER", "DAY_TRADER", "SWING", "POSITION"
  dominantEmotions   String? // JSON: ["fear", "greed"]
  strengths          String? // JSON: ["patient", "risk_management"]
  weaknesses         String? // JSON: ["early_close", "fomo"]
  bestSetup          String? // "ICT London"
  bestSession        String? // "NEW_YORK"
  bestRiskReward     String? // "1:2"
  totalTradesAnalyzed Int?   @default(0)
  analysisPeriod     String? // "3 months"
  updatedAt   DateTime @updatedAt

  trader Trader @relation(fields: [traderId], references: [id])
}

// ========================================
// PLAYBOOK DOMAIN
// ========================================

model Playbook {
  id          String   @id @default(cuid())
  traderId    String
  name        String   // e.g., "ICT London Session"
  description String?
  sessionType String?  // e.g., "LONDON", "NEW_YORK", "ASIAN", "CUSTOM"
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trader    Trader     @relation(fields: [traderId], references: [id])
  checklists PlaybookChecklist[]
  trades    TradeEntry[]
}

model PlaybookChecklist {
  id          String   @id @default(cuid())
  playbookId  String
  title       String   // e.g., "Trend Structure"
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  items    PlaybookChecklistItem[]
}

model PlaybookChecklistItem {
  id          String   @id @default(cuid())
  checklistId String
  text        String   // e.g., "HH/HL structure confirmed on H1+"
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  checklist PlaybookChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

// ========================================
// BEHAVIORAL ENGINE DOMAIN
// ========================================

model BehavioralEvent {
  id            String   @id @default(cuid())
  traderId      String
  tradeId       String?  // Associated trade (if detected from trade context)
  behaviorType  String   // REVENGE_TRADING, FOMO, OVERCONFIDENCE, FEAR, MOVING_STOP_LOSS, EARLY_CLOSE
  severity      String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  confidence    Float    @default(0) // 0.0 - 1.0 AI confidence
  evidence      String   // JSON: evidence data used for detection
  aiAnalysis    String?  // AI explanation of the behavior
  resolved      Boolean  @default(false)
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  trader Trader @relation(fields: [traderId], references: [id])
}

// ========================================
// GROWTH TIMELINE DOMAIN
// ========================================

model GrowthSnapshot {
  id               String   @id @default(cuid())
  traderId         String
  period           String   // "DAILY", "WEEKLY", "MONTHLY"
  periodDate       String   // "2024-01-15", "2024-W03", "2024-01"

  // Multi-dimensional scores (0-100)
  emotionScore       Float? // Emotional control score
  consistencyScore   Float? // Consistency of process
  processScore       Float? // Overall process adherence
  behaviorScore      Float? // Behavioral compliance
  disciplineScore    Float? // Following rules/plan
  riskMgmtScore       Float? // Risk management quality

  // Context
  totalTrades       Int      @default(0)
  winRate           Float?
  behavioralEvents  Int      @default(0)
  notes             String?  // AI-generated notes

  createdAt DateTime @default(now())

  trader Trader @relation(fields: [traderId], references: [id])
}

// ========================================
// PATTERN & INSIGHT DOMAIN (CP-02)
// ========================================

model PatternRegistry {
  id              String   @id @default(cuid())
  patternType     String   @unique // "REVENGE_TRADING", "PLAN_DEVIATION", etc
  detectionRule   String   // JSON description of detection logic
  minimumData     Int      // Minimum trades needed
  priority        Int      @default(1)
  reflectionTemplate String?
  notificationRule String?
  status          String   @default("EXPERIMENTAL") // EXPERIMENTAL, STABLE, DEPRECATED
  createdAt       DateTime @default(now())

  // Relations
  findings        PatternFinding[]
}

model PatternFinding {
  id          String   @id @default(cuid())
  traderId    String
  patternId   String
  confidenceScore Float   @default(0) // 0.0 - 1.0
  evidence    String   // JSON evidence data
  description String
  status      String   @default("ACTIVE")
  detectedAt  DateTime @default(now())

  pattern PatternRegistry @relation(fields: [patternId], references: [id])
}

model ReflectionGapRecord {
  id          String   @id @default(cuid())
  traderId    String
  tradeId     String?  // Trade where this gap was detected
  patternFindingId String?
  gapType     String   // "PLAN_VS_EXECUTION", "NO_REFLECTION", "EMOTION_IMPACT", "RULE_VIOLATION"
  description String
  plan        String?  // What was planned
  execution   String?  // What was actually executed
  gapAnalysis String? // AI explanation of the gap
  impact      String?  // HIGH, MEDIUM, LOW
  recommendation String? // AI recommendation to close the gap
  behaviorTag String?  // Related behavior: FOMO, REVENGE, etc
  severity    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  trader Trader @relation(fields: [traderId], references: [id])
}

model InsightCard {
  id          String   @id @default(cuid())
  traderId    String
  title       String
  content     String
  category    String   // "BEHAVIORAL", "PROCESS", "PERFORMANCE"
  sourceType  String   // "PATTERN_ENGINE", "AI_COACH", "SYSTEM"
  sourceRef   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ========================================
// ANALYTICS DOMAIN
// ========================================

model ProcessScoreSnapshot {
  id          String   @id @default(cuid())
  traderId    String
  score       Int      // 0-100
  components  String   // JSON: { discipline, consistency, reflection, riskManagement, emotionalControl }
  period      String   // "DAILY", "WEEKLY", "MONTHLY"
  periodDate  String   // "2024-01-15", "2024-W03", "2024-01"
  createdAt   DateTime @default(now())

  trader Trader @relation(fields: [traderId], references: [id])
}

model WeeklyReviewRecord {
  id          String   @id @default(cuid())
  traderId    String
  weekStart   String   // "2024-01-15"
  weekEnd     String   // "2024-01-21"
  summary     String   // AI-generated weekly summary
  highlights  String?  // JSON array of highlights
  areasToImprove String? // JSON array
  processScoreChange Float?
  totalTrades Int      @default(0)
  winRate     Float?
  totalPnL    Float?

  // Enhanced weekly review fields
  processScore      Int?     @default(0) // Process Score for the week
  ruleCompliance    Float?   // 0-100% how well rules were followed
  biggestMistake    String?  // AI-identified biggest mistake
  recommendation     String?  // AI recommendation for next week
  topBehavioralIssue String? // Most frequent behavioral issue
  playbookUsage      Float?   // 0-100% playbook usage rate
  emotionBreakdown   String? // JSON: { "calm": 60, "anxious": 25, "confident": 15 }

  createdAt DateTime @default(now())

  trader Trader @relation(fields: [traderId], references: [id])
}

// ========================================
// TRADING DNA DOMAIN
// ========================================

model TradingDNA {
  id               String   @id @default(cuid())
  traderId         String   @unique
  // Identity
  tradingStyle     String?  // "SCALPER", "DAY_TRADER", "SWING", "POSITION"
  dominantEmotion  String?  // "FEAR", "GREED", "PATIENCE", "DISCIPLINE"
  // Strengths & Weaknesses (AI-identified)
  strengths        String?  // JSON: ["Sabar menunggu setup", "Risk Management bagus"]
  weaknesses       String?  // JSON: ["Early Close", "FOMO saat London Open"]
  // Performance Patterns
  bestSetup        String?  // "ICT London"
  bestSession      String?  // "NEW_YORK"
  bestRiskReward   String?  // "1:2"
  bestPair         String?  // "EURUSD"
  worstSetup       String?  // "Breakout tanpa konfirmasi"
  worstSession     String?  // "ASIAN"
  // Stats
  totalTradesAnalyzed Int?  @default(0)
  analysisPeriod   String?  // "3 months"
  // AI Summary
  aiSummary        String?  // Full AI-generated DNA summary paragraph
  // Metadata
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  trader Trader @relation(fields: [traderId], references: [id])
}

// ========================================
// GROWTH REPORT DOMAIN
// ========================================

model GrowthReport {
  id               String   @id @default(cuid())
  traderId         String
  reportType       String   // "WEEKLY", "MONTHLY"
  periodStart      String   // "2024-01-15"
  periodEnd        String   // "2024-01-21"
  // Stats
  totalTrades      Int      @default(0)
  processScore     Int?     @default(0)
  processScoreChange Int?   // +/- from previous period
  winRate          Float?
  totalPnL         Float?
  ruleCompliance   Float?   // 0-100%
  playbookUsage    Float?   // 0-100%
  // AI Analysis
  behaviorsImproved  String? // JSON: ["Tidak lagi revenge trading"]
  behaviorsToImprove String? // JSON: ["Early Close"]
  nextWeekTargets   String? // JSON: ["Minimal 90% Rule Compliance"]
  aiSummary        String?  // Full AI-generated report
  highlight        String?  // Key highlight of the period
  // Generated
  generatedAt      DateTime @default(now())

  trader Trader @relation(fields: [traderId], references: [id])
}

// ========================================
// PLATFORM / INFRA DOMAIN
// ========================================

model PromptTemplateRegistry {
  id          String   @id @default(cuid())
  templateKey String   @unique // "REFLECTION_OPENING", "SOCRATIC_QUESTION", etc
  templateName String
  description  String?
  systemPrompt String   // L1 content
  templateBody String   // Template with placeholders
  category    String   // "COACHING", "ANALYSIS", "SUMMARY"
  modelPreference String @default("gpt-4o-mini") // "gpt-4o", "gpt-4o-mini"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model EventLog {
  id            String   @id @default(cuid())
  eventType     String
  correlationId String?
  traderId      String?
  ownerId       String? // Domain that owns this event
  payload       String? // JSON
  status        String   @default("PUBLISHED") // PUBLISHED, PROCESSED, FAILED, DLQ
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())
  processedAt   DateTime?
}
